# grok-faf-voice — environment variables
# Copy this to `.env` and fill in your values.
# `.env` is gitignored. `.env.example` is the tracked template.

# ---- xAI (required for Grok Voice) ----
# Get one at https://console.x.ai/
XAI_API_KEY=xai-...

# ---- LiveKit (required for AgentServer to connect) ----
# Get these from https://cloud.livekit.io/ or your self-hosted LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- MCPaaS (required for FAFMemory writes) ----
# Per-soul auth token. James's dev token: wolfe-68-orange
# Reads work without a token; writes need one.
MCPAAS_TOKEN=

# ---- Optional ----
# Override which soul FAFMemory binds to (default in examples: "grok")
# FAF_SOUL=grok
