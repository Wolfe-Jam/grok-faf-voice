# grok-faf-voice — environment variables
# Copy this to `.env` and fill in your values.
# `.env` is gitignored. `.env.example` is the tracked template.

# ---- xAI (required for Grok Voice) ----
# Get one at https://console.x.ai/
XAI_API_KEY=xai-...

# ---- LiveKit (required for AgentServer to connect) ----
# Get these from https://cloud.livekit.io/ or your self-hosted LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- MCPaaS (optional for now) ----
# Free Voice API key — coming soon on a dedicated page at mcpaas.live.
# Until it ships, FAFMemory works read-only against public souls.
# Without an API key, etch will raise FAFAuthRequiredError with a
# friendly "coming soon" message instead of writing.
#
# Note: mcpaas.live/slash/dashboard issues PAID Slash tokens for the
# API gateway product — separate from Voice. Don't use Slash tokens
# here; wait for the free Voice API key page.
MCPAAS_API_KEY=

# ---- Soul to bind FAFMemory to (any public soul works for read) ----
# Public read-only souls today: faf, grok, nelly, spacex, wolfe,
# liverpool, smithsonian.
#
# Once you have a free Voice API key + a claimed namepoint
# (free with `name + 2 digits` pattern: james77, amy123, atlanta96
# at mcpaas.live), set FAF_SOUL=<your-namepoint> and you can write
# to your own soul.
FAF_SOUL=grok
