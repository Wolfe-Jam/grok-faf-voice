# grok-faf-voice — environment variables
# Copy this to `.env` and fill in your values.
# `.env` is gitignored. `.env.example` is the tracked template.

# ---- xAI (required for Grok Voice) ----
# Get one at https://console.x.ai/
XAI_API_KEY=xai-...

# ---- LiveKit (required for AgentServer to connect) ----
# Get these from https://cloud.livekit.io/ or your self-hosted LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- MCPaaS (optional for now) ----
# Free Voice key — coming soon. Until it ships, FAFMemory works
# read-only against public souls. Without a token, etch will return
# a friendly "coming soon" message instead of writing.
MCPAAS_TOKEN=

# ---- Soul to bind FAFMemory to (any public soul works for read) ----
# Public read-only souls today: faf, grok, nelly, spacex, wolfe,
# liverpool, smithsonian. Once you have a free Voice key, you can
# write to any soul you own.
FAF_SOUL=grok
